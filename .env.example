# ─────────────────────────────────────────────────────────────────────────────
# Swastik App — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — database, storage, realtime, push notifications
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# YouTube Data API v3 — Live Darshan detection
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Maps — temple location & map screens
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stripe — donation payments (use test keys in dev, live keys in prod)
# WARNING: STRIPE_SECRET_KEY must NEVER be used in a production frontend.
#          It is only here for local development. Move it to a secure
#          backend / Cloud Function before going live.
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# ⚠️  DO NOT add STRIPE_WEBHOOK_SECRET here — this file is bundled into the
#     Flutter app as an asset. Set it only via Supabase CLI:
#       supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Edge Function secrets — set these via the Supabase CLI, NOT here:
#   supabase secrets set FIREBASE_PROJECT_ID=your-project-id
#   supabase secrets set FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#   supabase secrets set STRIPE_SECRET_KEY=sk_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# ─────────────────────────────────────────────────────────────────────────────
