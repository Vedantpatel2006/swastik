rules_version = '2';

// Firebase Storage Security Rules for Temple App
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Temple images - Public read, admin-only write
    match /temples/{templeId}/{allPaths=**} {
      allow read: if true;  // Anyone can view temple images
      allow write: if isAdmin();  // Only admins can upload/modify temple images
    }
    
    // Temple images folder - Public read, admin-only write
    match /temple_images/{allPaths=**} {
      allow read: if true;  // Anyone can view temple images
      allow write: if isAdmin();  // Only admins can upload temple images
    }
    
    // User profile images - Authenticated users only
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true;  // Public read for profile images
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User images folder - Authenticated users
    match /user_images/{allPaths=**} {
      allow read: if true;  // Public read
      allow write: if request.auth != null;  // Any authenticated user can upload
    }
    
    // Community images - Authenticated users
    match /community_images/{allPaths=**} {
      allow read: if true;  // Public read
      allow write: if request.auth != null;  // Any authenticated user can upload
    }
    
    // Event images - Public read, admin-only write
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Community posts images - Authenticated users
    match /posts/{postId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Donation receipts - Private to user and admin
    match /donations/{userId}/{allPaths=**} {
      allow read: if request.auth != null && 
                    (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
